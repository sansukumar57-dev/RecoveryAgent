# =====================================================================
#  AI Revenue Recovery — environment template
#  Copy to .env (same folder) and fill in real values:
#     Windows : Copy-Item .env.example .env
#     macOS   : cp .env.example .env
#  .env is gitignored and is loaded automatically at startup by
#  spring.config.import in src/main/resources/application.yml
# =====================================================================


# =====================================================================
#  1. GATEWAY API KEY  <<< PUT YOUR RAZORPAY KEYS HERE
# =====================================================================
#  Get them from: https://dashboard.razorpay.com/app/website-app-settings/api-keys
#    RAZORPAY_KEY_ID      rzp_test_xxxxxxxx (sandbox) / rzp_live_xxxxxxxx (real)
#    RAZORPAY_KEY_SECRET  shown only once when the key is generated
#    RAZORPAY_WEBHOOK_SECRET  from https://dashboard.razorpay.com/app/webhooks
#
#  Keeping the demo values below runs the app in simulated mode — no real
#  API calls are made and no money moves.
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_demo
RAZORPAY_KEY_SECRET=demo_secret
RAZORPAY_WEBHOOK_SECRET=demo_webhook_secret

# test = sandbox keys, live = real money
RAZORPAY_MODE=test

# Set true only once the two keys above are real
RAZORPAY_GATEWAY_ENABLED=false

# Gateway behaviour toggles
RAZORPAY_AUTO_CAPTURE=false
RAZORPAY_ENABLE_3DS=true
RAZORPAY_ENABLE_OFFUS=true
RAZORPAY_SETTLEMENT_CYCLE=T+2

# Endpoints
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_WEBHOOK_URL=http://localhost:8001/webhooks/razorpay


# =====================================================================
#  2. BACKEND API KEY (protects /api/**)
# =====================================================================
#  Sent by the frontend as the X-API-Key header. Must match
#  NEXT_PUBLIC_API_KEY in frontend/.env.local. Change it in production.
# ---------------------------------------------------------------------
APP_API_KEY=demo-api-key-123


# =====================================================================
#  3. LLM PROVIDER KEYS (optional)
# =====================================================================
#  Leave blank to run the rules-based fallback diagnosis.
#  groq       -> https://console.groq.com/keys
#  openrouter -> https://openrouter.ai/keys
#  nvidia     -> https://build.nvidia.com/
# ---------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_FALLBACK=nvidia
LLM_TIMEOUT_MS=8000

GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=


# =====================================================================
#  4. SERVER / DATABASE
# =====================================================================
SERVER_PORT=8001
# SPRING_DATASOURCE_URL=jdbc:sqlite:recovery.db
